<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="天気予報"
        Height="250"
        Width="400">

    <Grid Margin="20">

        <StackPanel>

            <TextBlock
        Text="東京の天気"
        FontSize="24"
        FontWeight="Bold"
        Margin="0,0,0,20"/>

            <TextBlock
        x:Name="TemperatureText"
        FontSize="18"
        Margin="0,5"/>

            <TextBlock
        x:Name="WeatherText"
        FontSize="18"
        Margin="0,5"/>

            <TextBlock
        x:Name="HumidityText"
        FontSize="18"
        Margin="0,5"/>

            <TextBlock
        x:Name="WindSpeedText"
        FontSize="18"
        Margin="0,5"/>

        </StackPanel>

    </Grid>

</Window>