<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        Title="天気予報"
        Height="900"
        Width="500"
        Background="#4A90E2">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="0,1">
                <GradientStop Color="#4A90E2"
                              Offset="0"/>
                <GradientStop Color="#87CEEB"
                              Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="20">

                <!-- 地域 -->

                <TextBlock x:Name="CityText"
                           Text="東京都"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           FontSize="36"
                           FontWeight="SemiBold"/>

                <!-- 現在気温 -->

                <TextBlock x:Name="TemperatureText"
                           Text="20°"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           FontSize="90"
                           FontWeight="Light"/>

                <!-- 天気 -->

                <TextBlock x:Name="WeatherText"
                           Text="☀ 晴れ"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           FontSize="28"/>

                <!-- 湿度と風速 -->

                <Border Background="#30FFFFFF"
                        CornerRadius="20"
                        Padding="15"
                        Margin="0,30,0,20">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="湿度"
                                       Foreground="White"
                                       FontSize="16"/>
                            <TextBlock x:Name="HumidityText"
                                       Foreground="White"
                                       FontSize="28"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="風速"
                                       Foreground="White"
                                       FontSize="16"/>
                            <TextBlock x:Name="WindSpeedText"
                                       Foreground="White"
                                       FontSize="28"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 地域変更 -->

                <WrapPanel HorizontalAlignment="Center"
                           Margin="0,0,0,20">

                    <ComboBox x:Name="CityComboBox"
                              Width="180"
                              Height="35"/>

                    <Button x:Name="UpdateButton"
                            Width="90"
                            Height="35"
                            Margin="10,0,0,0"
                            Click="UpdateButton_Click"
                            Content="更新"/>
                </WrapPanel>

                <!-- エラー -->

                <TextBlock x:Name="ErrorText"
                           Foreground="Yellow"
                           TextWrapping="Wrap"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <!-- 週間予報 -->

                <Border Background="#30FFFFFF"
                        CornerRadius="20"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="7日間予報"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <ListBox x:Name="ForecastListBox"
                                 Background="Transparent"
                                 BorderBrush="{x:Null}"
                                 Foreground="White"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>