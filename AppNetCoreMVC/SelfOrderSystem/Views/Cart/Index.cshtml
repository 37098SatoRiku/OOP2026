@model List<SelfOrderSystem.Models.CartItem>

@{
    ViewData["Title"] = "カート";
    var total = Model.Sum(x => x.LineTotal);
}

<div class="cart-container">

    <div class="cart-summary">
        <div>
            商品数 @Model.Sum(x => x.Quantity) 点
        </div>
        <div class="cart-summary-total">
            合計 @total.ToString("N0") 円
        </div>
    </div>

    <h1>カート</h1>

    @if(!Model.Any()) {
        <div class="cart-empty">
            <h4>カートは空です</h4>

            <a class="btn btn-primary mt-3"
               asp-controller="Menu"
               asp-action="Index">
                メニューへ戻る
            </a>
        </div>
    } else {
        @foreach(var item in Model) {
            <div class="card cart-item mb-3">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <div class="cart-product-name">
                                @item.ProductName
                            </div>

                            <div class="cart-product-detail">
                                @item.UnitPrice.ToString("N0") 円 × @item.Quantity
                            </div>
                        </div>

                        <div class="cart-price">
                            @item.LineTotal.ToString("N0") 円
                        </div>

                    </div>

                    <div class="row mt-3 g-2 cart-actions">

                        <div class="col-8">
                            <form asp-action="Update"
                                  method="post"
                                  class="d-flex gap-2">

                                <input type="hidden"
                                       name="productId"
                                       value="@item.ProductId" />

                                <input class="form-control quantity-input"
                                       type="number"
                                       name="quantity"
                                       min="1"
                                       max="99"
                                       value="@item.Quantity" />

                                <button type="submit"
                                        class="btn btn-outline-primary">
                                    変更
                                </button>

                            </form>
                        </div>

                        <div class="col-4">
                            <form asp-action="Remove"
                                  method="post">

                                <input type="hidden"
                                       name="productId"
                                       value="@item.ProductId" />

                                <button type="submit"
                                        class="btn btn-outline-danger cart-remove-btn">
                                    削除
                                </button>

                            </form>
                        </div>

                    </div>

                </div>
            </div>
        }

        <div class="cart-checkout-bar">
            <div class="cart-checkout-content">

                <div class="cart-checkout-total">
                    <span class="cart-checkout-label">
                        お支払い金額
                    </span>
                    <span class="cart-checkout-price">
                        @total.ToString("N0") 円
                    </span>
                </div>

                <a class="cart-checkout-btn"
                   asp-controller="Orders"
                   asp-action="Checkout">
                    注文内容を確認する
                </a>

            </div>
        </div>
    }

</div>