@model List<SelfOrderSystem.Models.CartItem>

@{
    ViewData["Title"] = "カート";
    var total = Model.Sum(x => x.LineTotal);
}

<div class="cart-container">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">カート</h1>
        <span class="badge bg-success fs-6">
            合計 @total.ToString("N0") 円
        </span>
    </div>

    @if(!Model.Any()) {
        <div class="alert alert-info">
            カートは空です
        </div>

        <a class="btn btn-primary w-100"
           asp-controller="Menu"
           asp-action="Index">
            メニューへ戻る
        </a>
    } else {
        @foreach(var item in Model) {
            <div class="card cart-item mb-3">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="product-name">
                                @item.ProductName
                            </div>

                            <div class="text-muted">
                                @item.UnitPrice.ToString("N0") 円 × @item.Quantity
                            </div>
                        </div>

                        <div class="fw-bold fs-5 text-success">
                            @item.LineTotal.ToString("N0") 円
                        </div>
                    </div>

                    <div class="row mt-3 g-2">

                        <div class="col-8">
                            <form asp-action="Update"
                                  method="post"
                                  class="d-flex gap-2">

                                <input type="hidden"
                                       name="productId"
                                       value="@item.ProductId" />

                                <input class="form-control quantity-input"
                                       type="number"
                                       name="quantity"
                                       min="1"
                                       max="99"
                                       value="@item.Quantity" />

                                <button class="btn btn-outline-primary">
                                    変更
                                </button>

                            </form>
                        </div>

                        <div class="col-4">
                            <form asp-action="Remove"
                                  method="post">

                                <input type="hidden"
                                       name="productId"
                                       value="@item.ProductId" />

                                <button class="btn btn-outline-danger w-100">
                                    削除
                                </button>

                            </form>
                        </div>

                    </div>

                </div>
            </div>
        }

        <div style="height:90px"></div>

        <div class="checkout-bar">
            <a class="btn btn-success btn-lg w-100"
               asp-controller="Orders"
               asp-action="Checkout">
                注文内容を確認する
                （@total.ToString("N0") 円）
            </a>
        </div>
    }
</div>